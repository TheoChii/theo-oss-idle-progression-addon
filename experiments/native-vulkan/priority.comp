#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Rows { vec4 rows[]; };
layout(set = 0, binding = 1, std430) writeonly buffer Results { float scores[]; };
void main() {
 uint i = gl_GlobalInvocationID.x;
 if (i >= scores.length()) return;
 vec4 r = rows[i];
 float score;
 if (r.w < 0.0) score = r.x;
 else {
   float increase = max(0.0, r.y - r.z) + max(0.0, r.z * 0.02);
   score = increase * r.w;
 }
 scores[i] = score;
}
